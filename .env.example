# Copy to .env for local development (NEVER commit .env). In CI these come from
# GitHub Actions Secrets. Create all API keys WITHOUT withdrawal/transfer permission.

# bitbank (crypto execution venue). OHLCV is public, so keys are only needed for trading.
BITBANK_API_KEY=
BITBANK_API_SECRET=

# Alpaca (US equities). Keys are needed even for historical data.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Use the paper endpoint unless you really mean it. Defaults to true.
ALPACA_PAPER=true

# OANDA (spot FX — the USD/JPY execution venue). Use a v20 token scoped to the single
# account you intend to trade: OANDA tokens cannot withdraw, but they can move funds
# between an account's own sub-accounts.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# Practice endpoint unless this is exactly "false". Reaching real money also requires
# TRADE_LIVE_ENABLED, so one stray variable is never enough.
OANDA_PRACTICE=true

# Master live-trading switch. Live execution is OFF unless this is exactly "true".
TRADE_LIVE_ENABLED=false
