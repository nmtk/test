# Copy to .env for local development (NEVER commit .env). In CI these come from
# GitHub Actions Secrets. Create all API keys WITHOUT withdrawal/transfer permission.

# bitbank (crypto execution venue). OHLCV is public, so keys are only needed for trading.
BITBANK_API_KEY=
BITBANK_API_SECRET=

# Alpaca (US equities). Keys are needed even for historical data.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Use the paper endpoint unless you really mean it. Defaults to true.
ALPACA_PAPER=true

# Master live-trading switch. Live execution is OFF unless this is exactly "true".
TRADE_LIVE_ENABLED=false
