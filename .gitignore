# Secrets — NEVER commit. Keys live only in GitHub Actions Secrets.
.env
*.env
secrets.*
*.key
*.pem

# Local data caches (regenerable). Curated state under state/ IS committed by the bot.
data/cache/
*.tmp

# OS
.DS_Store

# Derived state, deliberately not versioned.
# The paper rehearsal book is rewritten by `trade promote`, which runs immediately before
# `trade paper-step` in the same job, so no run ever reads a committed copy. Versioning it
# would add ~65KB to git history on every executor run (it was 1.3MB before the compact
# writer) for a file that is a within-job intermediate. If it is absent, paper_book_path
# falls back to champions.json, which means an empty book and no trades — the safe failure.
state/paper_champions.json
